# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# ---- Stripe ----
# Get from https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET

# ---- ESP (pick one provider; loops / resend / postmark) ----
ESP_PROVIDER=loops
ESP_API_KEY=REPLACE_WITH_ESP_API_KEY

# ---- Site ----
SITE_URL=http://localhost:8765
